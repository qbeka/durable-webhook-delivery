# Local databases, logs and built binaries
/.run/
/bin/

# Scratch output from experiments. Published evidence lives in results/.
/tmp/
*.log
*.pid

# Secrets never enter this repository
.env
.env.*

.DS_Store

# Local tool settings
/.claude/

# Published runs keep summaries, manifests and compact latency in Git.
# The full originals stay local. Manifests hold their hashes.
/results/**/*.log
/results/**/*.sends.csv.gz
/results/**/effects-*.csv
/results/**/effects-*.latency.csv.gz
